<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pipeta Server // La Sociedad Post</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <style>
        :root {
            --bg-body: #0d0f14;
            --bg-nav: #141721;
            --bg-panel: #181c27;
            --bg-card: #1e2330;
            --bg-card-hover: #252b3b;
            --border: #2c3245;
            --border-highlight: #3d455d;
            --text-main: #f1f5f9;
            --text-dim: #94a3b8;
            --text-muted: #64748b;
            --accent: #FF6B00;
            --accent-glow: rgba(255, 107, 0, 0.25);
            --cyan: #00d2ff;
            --emerald: #10b981;
            --amber: #f59e0b;
            --rose: #ef4444;
            --purple: #a855f7;
            --font-main: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            --font-mono: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: var(--bg-body);
            color: var(--text-main);
            font-family: var(--font-main);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
        }

        /* Topbar */
        header {
            background: var(--bg-nav);
            border-bottom: 1px solid var(--border);
            padding: 12px 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .brand-logo {
            font-size: 1.15rem;
            font-weight: 800;
            letter-spacing: 1px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .brand-logo span.pipeta {
            color: var(--accent);
        }

        .brand-logo span.server {
            color: var(--text-main);
            background: var(--bg-card);
            border: 1px solid var(--border-highlight);
            padding: 2px 8px;
            border-radius: 4px;
            font-size: 0.75rem;
            font-weight: 700;
            letter-spacing: 1.5px;
            text-transform: uppercase;
        }

        .pulse-dot {
            width: 8px;
            height: 8px;
            background: var(--emerald);
            border-radius: 50%;
            box-shadow: 0 0 10px var(--emerald);
            animation: pulse 2s infinite;
        }

        .pulse-dot.offline {
            background: var(--rose);
            box-shadow: 0 0 10px var(--rose);
            animation: none;
        }

        @keyframes pulse {
            0% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.4; transform: scale(0.9); }
            100% { opacity: 1; transform: scale(1); }
        }

        .top-stats {
            display: flex;
            gap: 16px;
            align-items: center;
        }

        .stat-pill {
            background: var(--bg-panel);
            border: 1px solid var(--border);
            border-radius: 6px;
            padding: 6px 12px;
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.82rem;
            font-family: var(--font-mono);
        }

        .stat-pill .num {
            font-weight: 700;
            color: var(--text-main);
        }

        .stat-pill.active .num { color: var(--cyan); }
        .stat-pill.pending .num { color: var(--amber); }
        .stat-pill.workers .num { color: var(--emerald); }

        .top-actions {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .btn {
            background: var(--bg-card);
            color: var(--text-main);
            border: 1px solid var(--border);
            padding: 7px 14px;
            border-radius: 6px;
            font-size: 0.82rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.15s ease;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            user-select: none;
        }

        .btn:hover {
            background: var(--bg-card-hover);
            border-color: var(--border-highlight);
        }

        .btn-pause {
            background: rgba(245, 158, 11, 0.15);
            border-color: rgba(245, 158, 11, 0.4);
            color: #fbbf24;
        }

        .btn-pause:hover {
            background: rgba(245, 158, 11, 0.25);
            border-color: #fbbf24;
        }

        .btn-resume {
            background: rgba(16, 185, 129, 0.15);
            border-color: rgba(16, 185, 129, 0.4);
            color: #34d399;
        }

        .btn-danger {
            background: rgba(239, 68, 68, 0.15);
            border-color: rgba(239, 68, 68, 0.4);
            color: #f87171;
        }

        .btn-danger:hover {
            background: rgba(239, 68, 68, 0.25);
            border-color: #f87171;
        }

        /* Main Container */
        main {
            padding: 24px;
            display: flex;
            flex-direction: row;
            align-items: flex-start;
            gap: 24px;
            max-width: 100%;
            margin: 0 auto;
            width: 100%;
            box-sizing: border-box;
        }

        .workers-sidebar {
            width: 360px;
            flex-shrink: 0;
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        .queue-main {
            flex: 1;
            min-width: 0;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .section-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 12px;
        }

        .section-title {
            font-size: 0.95rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--text-dim);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        /* Workers Grid */
        .workers-grid {
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        @media (max-width: 1180px) {
            main {
                flex-direction: column;
            }
            .workers-sidebar {
                width: 100%;
            }
        }

        .worker-card {
            background: var(--bg-panel);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 16px;
            display: flex;
            flex-direction: column;
            gap: 12px;
            position: relative;
            transition: border-color 0.2s;
        }

        .worker-card.online {
            border-left: 4px solid var(--emerald);
        }

        .worker-card.busy {
            border-left: 4px solid var(--cyan);
        }

        .worker-card.offline {
            border-left: 4px solid var(--rose);
            opacity: 0.7;
        }

        .worker-card.paused {
            border-left: 4px solid var(--amber);
        }

        .worker-card.restarting {
            border: 1px solid var(--amber) !important;
            border-left: 4px solid var(--amber) !important;
            box-shadow: 0 0 16px rgba(245, 158, 11, 0.35);
            animation: pulseRestart 2s infinite ease-in-out;
        }

        .worker-card.just-restarted {
            border: 1px solid var(--emerald) !important;
            border-left: 4px solid var(--emerald) !important;
            box-shadow: 0 0 16px rgba(16, 185, 129, 0.35);
        }

        @keyframes pulseRestart {
            0%, 100% {
                box-shadow: 0 0 10px rgba(245, 158, 11, 0.2);
                border-color: rgba(245, 158, 11, 0.5);
            }
            50% {
                box-shadow: 0 0 24px rgba(245, 158, 11, 0.55);
                border-color: rgba(245, 158, 11, 1);
            }
        }

        .spin-icon {
            display: inline-block;
            animation: spin 1.2s infinite linear;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .worker-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .worker-host {
            font-size: 1rem;
            font-weight: 700;
            color: var(--text-main);
            display: flex;
            align-items: center;
            gap: 8px;
            font-family: var(--font-mono);
        }

        .worker-ip {
            font-size: 0.78rem;
            color: var(--text-dim);
            font-family: var(--font-mono);
        }

        .status-badge {
            font-size: 0.7rem;
            font-weight: 700;
            letter-spacing: 0.5px;
            padding: 3px 8px;
            border-radius: 4px;
            text-transform: uppercase;
            font-family: var(--font-mono);
        }

        .badge-idle { background: rgba(16, 185, 129, 0.15); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.3); }
        .badge-processing { background: rgba(0, 210, 255, 0.15); color: #38bdf8; border: 1px solid rgba(0, 210, 255, 0.3); }
        .badge-refreshing { background: rgba(168, 85, 247, 0.15); color: #c084fc; border: 1px solid rgba(168, 85, 247, 0.3); }
        .badge-offline { background: rgba(239, 68, 68, 0.15); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.3); }
        .badge-paused { background: rgba(245, 158, 11, 0.15); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.3); }
        .badge-restarting { background: rgba(245, 158, 11, 0.2); color: #fbbf24; border: 1px solid #f59e0b; display: inline-flex; align-items: center; gap: 5px; }
        .badge-just-restarted { background: rgba(16, 185, 129, 0.2); color: #34d399; border: 1px solid #10b981; }

        .worker-active-task {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 6px;
            padding: 10px;
            font-size: 0.82rem;
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .active-task-label {
            font-size: 0.72rem;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .active-task-desc {
            font-family: var(--font-mono);
            font-size: 0.8rem;
            color: var(--text-main);
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .worker-meta {
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 0.75rem;
            color: var(--text-dim);
            font-family: var(--font-mono);
        }

        /* Filter bar */
        .filters-panel {
            background: var(--bg-panel);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 12px 16px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            flex-wrap: wrap;
        }

        .filter-tabs {
            display: flex;
            gap: 6px;
        }

        .tab-btn {
            background: transparent;
            border: 1px solid transparent;
            color: var(--text-dim);
            padding: 6px 12px;
            border-radius: 6px;
            font-size: 0.82rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.15s ease;
        }

        .tab-btn:hover {
            color: var(--text-main);
            background: var(--bg-card);
        }

        .tab-btn.active {
            background: var(--bg-card);
            color: var(--accent);
            border-color: var(--border-highlight);
        }

        .filter-inputs {
            display: flex;
            gap: 10px;
            align-items: center;
        }

        .input-select, .input-search {
            background: var(--bg-card);
            border: 1px solid var(--border);
            color: var(--text-main);
            padding: 6px 10px;
            border-radius: 6px;
            font-size: 0.82rem;
            outline: none;
        }

        .input-search {
            min-width: 220px;
        }

        .input-search:focus, .input-select:focus {
            border-color: var(--accent);
        }

        /* Queue Table */
        .queue-container {
            background: var(--bg-panel);
            border: 1px solid var(--border);
            border-radius: 8px;
            overflow: hidden;
        }

        .table-responsive {
            width: 100%;
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.82rem;
            text-align: left;
        }

        th {
            background: #11141c;
            color: var(--text-muted);
            font-weight: 700;
            text-transform: uppercase;
            font-size: 0.72rem;
            letter-spacing: 0.5px;
            padding: 12px 14px;
            border-bottom: 1px solid var(--border);
            white-space: nowrap;
        }

        td {
            padding: 12px 14px;
            border-bottom: 1px solid var(--border);
            vertical-align: middle;
        }

        tr:hover td {
            background: rgba(255, 255, 255, 0.02);
        }

        /* Priority Badges */
        .priority-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-family: var(--font-mono);
            font-size: 0.76rem;
            padding: 2px 8px;
            border-radius: 4px;
            cursor: pointer;
            transition: transform 0.1s;
        }

        .priority-badge:hover {
            transform: scale(1.08);
        }

        .priority-rush { background: rgba(239, 68, 68, 0.2); color: #f87171; border: 1px solid #ef4444; }
        .priority-high { background: rgba(255, 107, 0, 0.2); color: #ff8533; border: 1px solid #FF6B00; }
        .priority-normal { background: rgba(59, 130, 246, 0.2); color: #60a5fa; border: 1px solid #3b82f6; }
        .priority-low { background: rgba(100, 116, 139, 0.2); color: #94a3b8; border: 1px solid #64748b; }

        /* Type Badges */
        .type-badge {
            font-family: var(--font-mono);
            font-size: 0.72rem;
            font-weight: 700;
            padding: 2px 6px;
            border-radius: 4px;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .type-download { background: #0369a1; color: #bae6fd; }
        .type-upload { background: #047857; color: #a7f3d0; }
        .type-higgsfield_ingest { background: #7e22ce; color: #e9d5ff; }
        .type-refresh_folder { background: #b45309; color: #fde68a; }

        .project-tag {
            background: var(--bg-card);
            border: 1px solid var(--border-highlight);
            color: var(--text-main);
            padding: 2px 6px;
            border-radius: 4px;
            font-family: var(--font-mono);
            font-weight: 600;
            font-size: 0.75rem;
        }

        .user-tag {
            color: var(--text-dim);
            font-size: 0.78rem;
        }

        .mono-path {
            font-family: var(--font-mono);
            font-size: 0.76rem;
            color: var(--text-dim);
            max-width: 380px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        /* Progress Bar */
        .progress-box {
            display: flex;
            flex-direction: column;
            gap: 4px;
            min-width: 140px;
        }

        .progress-bar-bg {
            background: var(--bg-card);
            height: 6px;
            border-radius: 3px;
            overflow: hidden;
            border: 1px solid var(--border);
        }

        .progress-bar-fill {
            height: 100%;
            background: var(--cyan);
            border-radius: 3px;
            transition: width 0.3s ease;
        }

        .progress-bar-fill.completed { background: var(--emerald); }
        .progress-bar-fill.failed { background: var(--rose); }

        .progress-meta {
            display: flex;
            justify-content: space-between;
            font-size: 0.72rem;
            font-family: var(--font-mono);
            color: var(--text-muted);
        }

        .action-btns {
            display: flex;
            gap: 6px;
            align-items: center;
        }

        .btn-icon {
            padding: 4px 8px;
            font-size: 0.75rem;
        }

        /* Modal Priority */
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: rgba(0, 0, 0, 0.7);
            backdrop-filter: blur(4px);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 999;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.2s ease;
        }

        .modal-overlay.open {
            opacity: 1;
            pointer-events: auto;
        }

        .modal-card {
            background: var(--bg-panel);
            border: 1px solid var(--border-highlight);
            border-radius: 10px;
            padding: 24px;
            width: 100%;
            max-width: 440px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .modal-title {
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--text-main);
        }

        .priority-slider-box {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .slider-val {
            font-size: 2.2rem;
            font-weight: 800;
            font-family: var(--font-mono);
            color: var(--accent);
            text-align: center;
        }

        input[type="range"] {
            width: 100%;
            accent-color: var(--accent);
            cursor: pointer;
        }

        .preset-btns {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 8px;
        }

        .preset-btn {
            background: var(--bg-card);
            border: 1px solid var(--border);
            color: var(--text-main);
            padding: 6px;
            border-radius: 4px;
            font-size: 0.75rem;
            font-weight: 700;
            cursor: pointer;
            text-align: center;
        }

        .preset-btn:hover {
            border-color: var(--accent);
        }

        .modal-footer {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            margin-top: 8px;
        }

        /* Modal Restart Stepper */
        .modal-restart-card {
            max-width: 520px;
            gap: 16px;
        }

        .restart-modal-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid var(--border);
            padding-bottom: 12px;
        }

        .restart-modal-title {
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--text-main);
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .restart-target-badge {
            background: rgba(0, 210, 255, 0.15);
            border: 1px solid rgba(0, 210, 255, 0.3);
            color: var(--cyan);
            font-family: var(--font-mono);
            font-size: 0.8rem;
            font-weight: 700;
            padding: 3px 10px;
            border-radius: 4px;
        }

        .restart-stepper {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .restart-step {
            display: flex;
            align-items: center;
            gap: 14px;
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 12px 14px;
            transition: all 0.25s ease;
        }

        .restart-step.active {
            border-color: var(--amber);
            background: rgba(245, 158, 11, 0.08);
            box-shadow: 0 0 12px rgba(245, 158, 11, 0.2);
        }

        .restart-step.done {
            border-color: rgba(16, 185, 129, 0.5);
            background: rgba(16, 185, 129, 0.05);
        }

        .step-num {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: var(--font-mono);
            font-size: 0.8rem;
            font-weight: 800;
            background: #11141c;
            border: 1px solid var(--border);
            color: var(--text-dim);
            flex-shrink: 0;
            transition: all 0.2s ease;
        }

        .restart-step.active .step-num {
            background: var(--amber);
            border-color: var(--amber);
            color: #0b0e14;
            box-shadow: 0 0 8px rgba(245, 158, 11, 0.6);
        }

        .restart-step.done .step-num {
            background: var(--emerald);
            border-color: var(--emerald);
            color: #0b0e14;
        }

        .step-content {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .step-title {
            font-size: 0.85rem;
            font-weight: 700;
            color: var(--text-main);
        }

        .restart-step.active .step-title {
            color: #fbbf24;
        }

        .restart-step.done .step-title {
            color: #34d399;
        }

        .step-desc {
            font-size: 0.74rem;
            color: var(--text-dim);
        }

        .step-icon {
            font-size: 1.1rem;
            flex-shrink: 0;
            color: var(--text-muted);
        }

        .restart-step.active .step-icon {
            color: var(--amber);
        }

        .restart-step.done .step-icon {
            color: var(--emerald);
        }

        .restart-success-banner {
            background: rgba(16, 185, 129, 0.12);
            border: 1px solid var(--emerald);
            border-radius: 8px;
            padding: 12px 14px;
            display: flex;
            align-items: center;
            gap: 12px;
            animation: fadeIn 0.3s ease;
        }

        .restart-warning-banner {
            background: rgba(239, 68, 68, 0.12);
            border: 1px solid var(--rose);
            border-radius: 8px;
            padding: 12px 14px;
            display: flex;
            align-items: center;
            gap: 12px;
            animation: fadeIn 0.3s ease;
        }

        .success-icon, .warning-icon {
            font-size: 1.5rem;
            flex-shrink: 0;
        }

        .success-headline {
            font-size: 0.9rem;
            font-weight: 800;
            color: #34d399;
            letter-spacing: 0.5px;
        }

        .success-detail {
            font-size: 0.76rem;
            color: var(--text-dim);
            margin-top: 2px;
        }

        .warning-headline {
            font-size: 0.9rem;
            font-weight: 800;
            color: #f87171;
        }

        .warning-detail {
            font-size: 0.76rem;
            color: var(--text-dim);
            margin-top: 2px;
        }

        .restart-timer-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 0.76rem;
            color: var(--text-dim);
            font-family: var(--font-mono);
            background: #0d1017;
            padding: 8px 12px;
            border-radius: 6px;
            border: 1px solid var(--border);
        }

        /* Toast */
        #toast {
            position: fixed;
            bottom: 24px;
            right: 24px;
            background: var(--bg-card);
            border: 1px solid var(--border-highlight);
            color: var(--text-main);
            padding: 10px 18px;
            border-radius: 6px;
            font-size: 0.85rem;
            box-shadow: 0 6px 20px rgba(0,0,0,0.5);
            transform: translateY(100px);
            opacity: 0;
            transition: all 0.25s ease;
            z-index: 1000;
            font-family: var(--font-mono);
        }

        #toast.show {
            transform: translateY(0);
            opacity: 1;
        }
    </style>
</head>
<body>

    <!-- Header Navigation -->
    <header>
        <div class="brand">
            <div class="pulse-dot" id="serverPulse"></div>
            <div class="brand-logo">
                <span class="pipeta">PIPETA</span>
                <span class="server">Server</span>
            </div>
            <span style="font-size: 0.75rem; color: var(--text-muted); font-family: var(--font-mono);">La Sociedad Post // VFX Studio</span>
        </div>

        <div class="top-stats">
            <div class="stat-pill workers">
                <span>WORKERS:</span>
                <span class="num" id="statWorkers">0</span>
            </div>
            <div class="stat-pill active">
                <span>EN PROCESO:</span>
                <span class="num" id="statProcessing">0</span>
            </div>
            <div class="stat-pill pending">
                <span>EN COLA:</span>
                <span class="num" id="statPending">0</span>
            </div>
        </div>

        <div class="top-actions">
            <button class="btn btn-pause" id="btnToggleQueue" onclick="toggleGlobalQueue()">
                <span id="queuePauseIcon">⏸</span>
                <span id="queuePauseText">Pausar Cola Global</span>
            </button>
            <button class="btn" onclick="clearFinishedHistory()">
                Limpiar Historial
            </button>
        </div>
    </header>

    <!-- Main Dashboard -->
    <main>
        <!-- Workers Column (Sidebar) -->
        <aside class="workers-sidebar">
            <div class="section-header">
                <div class="section-title">
                    <span>🖥️</span> Nodos de Procesamiento (Workers)
                </div>
                <div style="font-size: 0.75rem; color: var(--text-dim); font-family: var(--font-mono);" id="workersSummaryText">
                    Escaneando nodos en red...
                </div>
            </div>
            <div class="workers-grid" id="workersGrid">
                <!-- Tarjetas de Workers renderizadas dinámicamente -->
            </div>
        </aside>

        <!-- Queue Column (Main Area) -->
        <section class="queue-main">
            <div class="section-header">
                <div class="section-title">
                    Transfer Queue
                </div>
            </div>

            <!-- Filters -->
            <div class="filters-panel">
                <div class="filter-tabs">
                    <button class="tab-btn active" onclick="setFilterStatus('all')">Todas (<span id="countAll">0</span>)</button>
                    <button class="tab-btn" onclick="setFilterStatus('processing')">En Proceso (<span id="countProc">0</span>)</button>
                    <button class="tab-btn" onclick="setFilterStatus('pending')">En Cola (<span id="countPend">0</span>)</button>
                    <button class="tab-btn" onclick="setFilterStatus('paused')">Pausadas (<span id="countPau">0</span>)</button>
                    <button class="tab-btn" onclick="setFilterStatus('completed')">Completadas (<span id="countComp">0</span>)</button>
                    <button class="tab-btn" onclick="setFilterStatus('failed')">Fallidas (<span id="countFail">0</span>)</button>
                </div>

                <div class="filter-inputs">
                    <select class="input-select" id="filterType" onchange="renderQueue()">
                        <option value="all">Todos los tipos</option>
                        <option value="download">Drive: Descarga</option>
                        <option value="upload">Drive: Subida</option>
                        <option value="higgsfield_ingest">IA Ingest (Higgsfield)</option>
                        <option value="refresh_folder">Refresco Carpeta</option>
                        <option value="server_download">Servidor: Descarga</option>
                        <option value="server_upload">Servidor: Subida</option>
                    </select>
                    <select class="input-select" id="filterProject" onchange="renderQueue()">
                        <option value="all">Todos los proyectos</option>
                    </select>
                    <input type="text" class="input-search" id="filterSearch" placeholder="Buscar por shot, archivo, usuario..." oninput="renderQueue()">
                </div>
            </div>

            <!-- Queue Table -->
            <div class="queue-container">
                <div class="table-responsive">
                    <table>
                        <thead>
                            <tr>
                                <th style="width: 65px;">Prioridad</th>
                                <th style="width: 120px;">Tipo</th>
                                <th style="width: 110px;">Proyecto</th>
                                <th style="width: 120px;">Usuario</th>
                                <th>Detalle / Destino</th>
                                <th style="width: 160px;">Progreso / Velocidad</th>
                                <th style="width: 155px;">Inicio / Fin</th>
                                <th style="width: 120px;">Estado</th>
                                <th style="width: 130px; text-align: right;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="queueTableBody">
                            <tr>
                                <td colspan="9" style="text-align: center; color: var(--text-dim); padding: 30px;">
                                    Conectando al servidor...
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
    </main>

    <!-- Modal Ajuste de Prioridad -->
    <div class="modal-overlay" id="priorityModal">
        <div class="modal-card">
            <div class="modal-title">Ajustar Prioridad de Tarea</div>
            <div style="font-size: 0.8rem; color: var(--text-dim); font-family: var(--font-mono);" id="modalTaskDesc">
                order_xxx
            </div>

            <div class="priority-slider-box">
                <div class="slider-val" id="modalSliderVal">50</div>
                <input type="range" id="modalPrioritySlider" min="1" max="100" value="50" oninput="updateModalSlider(this.value)">
                
                <div class="preset-btns">
                    <button class="preset-btn" style="color: #94a3b8;" onclick="updateModalSlider(20)">20 (Fondo)</button>
                    <button class="preset-btn" style="color: #60a5fa;" onclick="updateModalSlider(50)">50 (Normal)</button>
                    <button class="preset-btn" style="color: #ff8533;" onclick="updateModalSlider(80)">80 (Urgente)</button>
                    <button class="preset-btn" style="color: #f87171;" onclick="updateModalSlider(100)">100 (Rush)</button>
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn" onclick="closePriorityModal()">Cancelar</button>
                <button class="btn" style="background: var(--accent); border-color: var(--accent); color: #fff;" onclick="saveTaskPriority()">Guardar Prioridad</button>
            </div>
        </div>
    </div>

    <!-- Modal Progreso de Reinicio de Worker -->
    <div class="modal-overlay" id="restartModal">
        <div class="modal-card modal-restart-card">
            <div class="restart-modal-header">
                <div class="restart-modal-title">
                    <span class="spin-icon">🔄</span>
                    <span>Reinicio de Worker</span>
                </div>
                <span class="restart-target-badge" id="restartModalTargetHost">nodo-worker</span>
            </div>

            <div class="restart-stepper">
                <div class="restart-step" id="restartStep1">
                    <div class="step-num">1</div>
                    <div class="step-content">
                        <div class="step-title">Orden de reinicio emitida</div>
                        <div class="step-desc">Bandera generada en la red de almacenamiento</div>
                    </div>
                    <div class="step-icon" id="restartIcon1">⏳</div>
                </div>

                <div class="restart-step" id="restartStep2">
                    <div class="step-num">2</div>
                    <div class="step-content">
                        <div class="step-title">Cierre de proceso anterior</div>
                        <div class="step-desc">Worker finalizando tareas y liberando recursos</div>
                    </div>
                    <div class="step-icon" id="restartIcon2">○</div>
                </div>

                <div class="restart-step" id="restartStep3">
                    <div class="step-num">3</div>
                    <div class="step-content">
                        <div class="step-title">Relanzamiento automático</div>
                        <div class="step-desc">Supervisor de Windows ejecutando cuenta regresiva (10s)</div>
                    </div>
                    <div class="step-icon" id="restartIcon3">○</div>
                </div>

                <div class="restart-step" id="restartStep4">
                    <div class="step-num">4</div>
                    <div class="step-content">
                        <div class="step-title">Confirmación de nuevo latido</div>
                        <div class="step-desc">Verificando nuevo PID y conexión con la red</div>
                    </div>
                    <div class="step-icon" id="restartIcon4">○</div>
                </div>
            </div>

            <!-- Banner de éxito final -->
            <div class="restart-success-banner" id="restartSuccessBanner" style="display: none;">
                <div class="success-icon">✅</div>
                <div class="success-text">
                    <div class="success-headline">¡REINICIO COMPLETADO CON ÉXITO!</div>
                    <div class="success-detail" id="restartSuccessDetail">El worker está en línea con nuevo PID y código actualizado de la red.</div>
                </div>
            </div>

            <!-- Banner de advertencia si timeout -->
            <div class="restart-warning-banner" id="restartWarningBanner" style="display: none;">
                <div class="warning-icon">⚠️</div>
                <div class="warning-text">
                    <div class="warning-headline">Tiempo de espera prolongado</div>
                    <div class="warning-detail" id="restartWarningDetail">El worker aún no ha confirmado el nuevo latido. Verifique si la consola del nodo está abierta.</div>
                </div>
            </div>

            <div class="restart-timer-bar">
                <span id="restartElapsedLabel">Tiempo transcurrido: 0s</span>
                <span id="restartPidInfo">PID previo: -</span>
            </div>

            <div class="modal-footer">
                <button class="btn" id="btnRestartDismiss" onclick="closeRestartModal()">Minimizar</button>
                <button class="btn" id="btnRestartDone" style="display: none; background: var(--emerald); border-color: var(--emerald); color: #fff; font-weight: 700;" onclick="closeRestartModal()">¡Listo, Entendido!</button>
            </div>
        </div>
    </div>

    <!-- Modal Despertar / Estado de Worker -->
    <div class="modal-overlay" id="wakeModal">
        <div class="modal-card modal-restart-card">
            <div class="restart-modal-header">
                <div class="restart-modal-title">
                    <span>⚡</span>
                    <span>Levantar Nodo Worker</span>
                </div>
                <span class="restart-target-badge" id="wakeModalHost">nodo</span>
            </div>

            <div id="wakeModalContent" style="display:flex; flex-direction:column; gap:12px;">
                <div style="font-size:0.85rem; color:var(--text-dim); text-align:center; padding:20px 0;">
                    <span class="spin-icon">🔄</span> Comprobando conectividad con el nodo...
                </div>
            </div>

            <div class="modal-footer" style="margin-top: 14px;">
                <button class="btn" onclick="closeWakeModal()">Cerrar</button>
            </div>
        </div>
    </div>

    <!-- Toast -->
    <div id="toast">Mensaje de notificación</div>

    <script>
        let currentSnapshot = {
            queuePaused: false,
            workers: [],
            orders: [],
            counts: {}
        };
        let activeStatusFilter = 'all';
        let targetTaskIdForPriority = null;

        function showToast(msg) {
            const t = document.getElementById('toast');
            t.innerText = msg;
            t.classList.add('show');
            setTimeout(() => t.classList.remove('show'), 3000);
        }

        // Conectar SSE para tiempo real
        function initSSE() {
            const es = new EventSource('/api/server/events');
            
            es.onopen = () => {
                document.getElementById('serverPulse').classList.remove('offline');
            };

            es.onmessage = (event) => {
                try {
                    const data = JSON.parse(event.data);
                    currentSnapshot = data;
                    updateDashboard();
                } catch(e) {}
            };

            es.onerror = () => {
                document.getElementById('serverPulse').classList.add('offline');
                setTimeout(initSSE, 3000);
            };
        }

        function updateDashboard() {
            // 1. Stats de la barra superior
            const counts = currentSnapshot.counts || {};
            document.getElementById('statWorkers').innerText = `${counts.onlineWorkers || 0}/${counts.totalWorkers || 0}`;
            document.getElementById('statProcessing').innerText = counts.processing || 0;
            document.getElementById('statPending').innerText = counts.pending || 0;

            // 2. Botón de Pausa Global
            const isPaused = !!currentSnapshot.queuePaused;
            const btnToggle = document.getElementById('btnToggleQueue');
            const pauseIcon = document.getElementById('queuePauseIcon');
            const pauseText = document.getElementById('queuePauseText');

            if (isPaused) {
                btnToggle.className = 'btn btn-resume';
                pauseIcon.innerText = '▶';
                pauseText.innerText = 'Reanudar Cola Global';
            } else {
                btnToggle.className = 'btn btn-pause';
                pauseIcon.innerText = '⏸';
                pauseText.innerText = 'Pausar Cola Global';
            }

            // 3. Render Workers
            renderWorkers();

            // 4. Render Queue
            renderQueue();
        }

        function renderWorkers() {
            const grid = document.getElementById('workersGrid');
            const workers = currentSnapshot.workers || [];

            if (workers.length === 0) {
                grid.innerHTML = `
                    <div style="grid-column: 1/-1; padding: 24px; text-align: center; color: var(--text-dim); background: var(--bg-panel); border: 1px solid var(--border); border-radius: 8px;">
                        No se detectaron nodos Workers registrados en la red.
                    </div>
                `;
                document.getElementById('workersSummaryText').innerText = '0 nodos activos';
                return;
            }

            document.getElementById('workersSummaryText').innerText = `${workers.filter(w => w.isOnline).length} de ${workers.length} nodos en línea`;

            let html = '';
            for (const w of workers) {
                let cardClass = w.isOnline ? 'online' : 'offline';
                let badgeClass = 'badge-offline';
                let badgeText = 'APAGADO';

                if (w.isRestarting) {
                    cardClass = 'restarting';
                    badgeClass = 'badge-restarting';
                    badgeText = '<span class="spin-icon">🔄</span> REINICIANDO...';
                } else if (w.justRestarted) {
                    cardClass = 'just-restarted';
                    badgeClass = 'badge-just-restarted';
                    badgeText = `✅ REINICIADO (${w.pid || 'OK'})`;
                } else if (w.isOnline) {
                    if (w.status === 'processing') {
                        cardClass = 'busy';
                        badgeClass = 'badge-processing';
                        badgeText = 'PROCESANDO';
                    } else if (w.status === 'refreshing_folder') {
                        cardClass = 'busy';
                        badgeClass = 'badge-refreshing';
                        badgeText = 'REFRESCANDO';
                    } else if (w.status === 'paused') {
                        cardClass = 'paused';
                        badgeClass = 'badge-paused';
                        badgeText = 'PAUSADO';
                    } else {
                        badgeClass = 'badge-idle';
                        badgeText = 'LIBRE / LISTO';
                    }
                }

                let activeTaskHtml = '<div style="color: var(--text-muted); font-size: 0.78rem;">Sin tareas activas</div>';
                if (w.isRestarting) {
                    const stepDesc = w.restartStatus?.message || 'Reiniciando proceso en la máquina remota...';
                    activeTaskHtml = `
                        <div class="active-task-desc" style="color: var(--amber); display: flex; align-items: center; gap: 6px;">
                            <span class="spin-icon">🔄</span> ${stepDesc}
                        </div>
                        <div style="font-size: 0.72rem; color: var(--text-dim); font-family: var(--font-mono);">
                            Paso ${w.restartStatus?.step || 1} de 4 • ${w.restartStatus?.elapsed || 0}s transcurridos
                        </div>
                    `;
                } else if (w.activeTask) {
                    const taskName = w.activeTask.orderId || w.activeTask.project || 'Transferencia activa';
                    const pct = w.activeTask.progress?.percentage || 0;
                    const speed = w.activeTask.progress?.speedFormatted || '';
                    activeTaskHtml = `
                        <div class="active-task-desc">${taskName} [${w.activeTask.type || ''}]</div>
                        <div style="display:flex; justify-content:space-between; font-size:0.72rem; color:var(--cyan); font-family:var(--font-mono);">
                            <span>${pct}%</span>
                            <span>${speed}</span>
                        </div>
                    `;
                } else if (!w.isOnline) {
                    activeTaskHtml = `
                        <div style="color: var(--rose); font-size: 0.76rem; display: flex; align-items: center; gap: 6px;">
                            <span>⚠️</span> Equipo apagado o consola de Worker cerrada
                        </div>
                    `;
                }

                const memFreeGb = w.system ? (w.system.freeMem / 1024 / 1024 / 1024).toFixed(1) : '-';
                const memTotGb = w.system ? (w.system.totalMem / 1024 / 1024 / 1024).toFixed(1) : '-';

                let restartBtnHtml = '';
                if (w.isRestarting) {
                    restartBtnHtml = `
                        <button class="btn btn-icon" style="color: var(--amber); border-color: rgba(245,158,11,0.6); font-size: 0.72rem; padding: 2px 8px; background: rgba(245,158,11,0.12);" title="Ver pasos del reinicio en curso" onclick="openRestartModalForHost('${w.hostname}')">
                            <span class="spin-icon">🔄</span> Ver Pasos...
                        </button>
                    `;
                } else if (w.isOnline) {
                    restartBtnHtml = `
                        <button class="btn btn-icon" style="color: var(--amber); border-color: rgba(245,158,11,0.3); font-size: 0.72rem; padding: 2px 7px;" title="Reiniciar Worker y recargar última versión" onclick="restartWorker('${w.hostname}')">
                            🔄 Reiniciar
                        </button>
                    `;
                } else {
                    restartBtnHtml = `
                        <button class="btn btn-icon" style="color: var(--cyan); border-color: rgba(0, 210, 255, 0.4); font-size: 0.72rem; padding: 2px 8px; background: rgba(0, 210, 255, 0.08);" title="Comprobar estado y levantar Worker" onclick="wakeWorker('${w.hostname}')">
                            ⚡ Levantar
                        </button>
                    `;
                }

                const pingLabel = formatRelativeTime(w.lastPingSecondsAgo);

                html += `
                    <div class="worker-card ${cardClass}">
                        <div class="worker-top">
                            <div>
                                <div class="worker-host">
                                    <span>${w.hostname}</span>
                                </div>
                                <div class="worker-ip">IP: ${w.ip} ${w.pid ? '• PID: ' + w.pid : ''}</div>
                            </div>
                            <div style="display:flex; align-items:center; gap:8px;">
                                <span class="status-badge ${badgeClass}">${badgeText}</span>
                                ${restartBtnHtml}
                            </div>
                        </div>

                        <div class="worker-active-task">
                            <div class="active-task-label">Tarea en curso</div>
                            ${activeTaskHtml}
                        </div>

                        <div class="worker-meta">
                            <span>RAM: ${w.isOnline ? `${memFreeGb}GB / ${memTotGb}GB` : '-'}</span>
                            <span>Latido: ${pingLabel}</span>
                        </div>
                    </div>
                `;
            }

            grid.innerHTML = html;
        }

        function setFilterStatus(status) {
            activeStatusFilter = status;
            document.querySelectorAll('.filter-tabs .tab-btn').forEach(btn => btn.classList.remove('active'));
            event.target.classList.add('active');
            renderQueue();
        }

        function formatRelativeTime(sec) {
            if (!sec || sec > 900000) return 'Sin registro';
            if (sec < 60) return `hace ${sec}s`;
            const mins = Math.round(sec / 60);
            if (mins < 60) return `hace ${mins} min`;
            const hrs = Math.round(mins / 60);
            if (hrs < 24) return `hace ${hrs} h`;
            const days = Math.round(hrs / 24);
            return `hace ${days} días`;
        }

        function formatDateTime(isoStr) {
            if (!isoStr) return '-';
            try {
                const d = new Date(isoStr);
                if (isNaN(d.getTime())) return '-';
                const day = String(d.getDate()).padStart(2, '0');
                const month = String(d.getMonth() + 1).padStart(2, '0');
                const hours = String(d.getHours()).padStart(2, '0');
                const mins = String(d.getMinutes()).padStart(2, '0');
                const secs = String(d.getSeconds()).padStart(2, '0');
                return `${day}/${month} ${hours}:${mins}:${secs}`;
            } catch(e) {
                return '-';
            }
        }

        function renderQueue() {
            const orders = currentSnapshot.orders || [];
            const projectFilter = document.getElementById('filterProject').value;
            const typeFilter = document.getElementById('filterType') ? document.getElementById('filterType').value : 'all';
            const searchFilter = (document.getElementById('filterSearch').value || '').trim().toLowerCase();

            // Actualizar contadores de pestañas
            const counts = currentSnapshot.counts || {};
            document.getElementById('countAll').innerText = counts.totalOrders || 0;
            document.getElementById('countProc').innerText = counts.processing || 0;
            document.getElementById('countPend').innerText = counts.pending || 0;
            document.getElementById('countPau').innerText = counts.paused || 0;
            document.getElementById('countComp').innerText = counts.completed || 0;
            document.getElementById('countFail').innerText = counts.failed || 0;

            // Actualizar proyectos en select
            const projectSelect = document.getElementById('filterProject');
            const allProjects = Array.from(new Set(orders.map(o => o.project).filter(Boolean)));
            const currentSelected = projectSelect.value;
            let optionsHtml = '<option value="all">Todos los proyectos</option>';
            for (const p of allProjects) {
                optionsHtml += `<option value="${p}" ${p === currentSelected ? 'selected' : ''}>${p}</option>`;
            }
            projectSelect.innerHTML = optionsHtml;

            // Filtrar
            let filtered = orders.filter(o => {
                if (activeStatusFilter === 'processing' && o.status !== 'processing') return false;
                if (activeStatusFilter === 'pending' && o.status !== 'pending') return false;
                if (activeStatusFilter === 'paused' && o.status !== 'paused') return false;
                if (activeStatusFilter === 'completed' && o.status !== 'completed' && o.status !== 'completed_with_errors') return false;
                if (activeStatusFilter === 'failed' && o.status !== 'failed') return false;

                if (typeFilter !== 'all' && o.type !== typeFilter) return false;
                if (projectFilter !== 'all' && o.project?.toLowerCase() !== projectFilter.toLowerCase()) return false;

                if (searchFilter) {
                    const matchId = o.id.toLowerCase().includes(searchFilter);
                    const matchUser = (o.user || '').toLowerCase().includes(searchFilter);
                    const matchProj = (o.project || '').toLowerCase().includes(searchFilter);
                    const matchItems = o.items && o.items.some(i => (i.name || i.onlinePath || i.targetLocalPath || '').toLowerCase().includes(searchFilter));
                    if (!matchId && !matchUser && !matchProj && !matchItems) return false;
                }
                return true;
            });

            const tbody = document.getElementById('queueTableBody');
            if (filtered.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="9" style="text-align: center; color: var(--text-dim); padding: 30px;">
                            No hay órdenes en este filtro.
                        </td>
                    </tr>
                `;
                return;
            }

            let html = '';
            for (const o of filtered) {
                const p = o.priority || 50;
                let pClass = 'priority-normal';
                if (p >= 90) pClass = 'priority-rush';
                else if (p >= 75) pClass = 'priority-high';
                else if (p <= 30) pClass = 'priority-low';

                const typeClass = `type-${o.type || 'download'}`;

                // Formateo de detalle
                let detailText = '';
                if (o.items && o.items.length > 0) {
                    const first = o.items[0];
                    const firstTitle = first.name || first.relativePath || first.onlinePath || 'Archivo';
                    detailText = `<div class="mono-path" title="${firstTitle}">${firstTitle}</div>`;
                    if (o.items.length > 1) {
                        detailText += `<div style="font-size: 0.72rem; color: var(--text-muted); font-family: var(--font-mono);">+${o.items.length - 1} items más</div>`;
                    }
                } else {
                    detailText = `<div class="mono-path">${o.id}</div>`;
                }

                // Fechas Inicio / Fin / Duración
                let datesHtml = '';
                if (o.startedAt) {
                    datesHtml += `<div style="font-family: var(--font-mono); font-size: 0.72rem; color: var(--text-main);" title="Hora de Inicio">▶ ${formatDateTime(o.startedAt)}</div>`;
                } else if (o.createdAt) {
                    datesHtml += `<div style="font-family: var(--font-mono); font-size: 0.7rem; color: var(--text-muted);" title="Hora de Creación">⏱ ${formatDateTime(o.createdAt)}</div>`;
                }
                if (o.completedAt) {
                    const dur = (o.durationSeconds !== null && o.durationSeconds !== undefined) ? ` (${o.durationSeconds}s)` : '';
                    datesHtml += `<div style="font-family: var(--font-mono); font-size: 0.72rem; color: var(--emerald);" title="Hora de Fin">✓ ${formatDateTime(o.completedAt)}${dur}</div>`;
                } else if (o.status === 'processing') {
                    datesHtml += `<div style="font-family: var(--font-mono); font-size: 0.7rem; color: var(--cyan);">En curso...</div>`;
                } else if (o.status === 'pending') {
                    datesHtml += `<div style="font-family: var(--font-mono); font-size: 0.7rem; color: var(--amber);">En espera</div>`;
                }

                // Progreso
                let pct = 0;
                let speedText = '';
                let etaText = '';
                if (o.status === 'completed') {
                    pct = 100;
                    speedText = 'Finalizado';
                } else if (o.progress) {
                    pct = o.progress.percentage || 0;
                    speedText = o.progress.speedFormatted || '';
                    if (o.progress.etaSeconds !== null && o.progress.etaSeconds !== undefined) {
                        etaText = `ETA: ${o.progress.etaSeconds}s`;
                    }
                }

                let fillClass = o.status === 'completed' ? 'completed' : (o.status === 'failed' ? 'failed' : '');

                // Estado
                let statusBadge = '';
                if (o.status === 'processing') statusBadge = '<span class="status-badge badge-processing">EN PROCESO</span>';
                else if (o.status === 'pending') statusBadge = '<span class="status-badge badge-idle">EN COLA</span>';
                else if (o.status === 'paused') statusBadge = '<span class="status-badge badge-paused">PAUSADA</span>';
                else if (o.status === 'completed') statusBadge = '<span class="status-badge badge-idle">COMPLETADA</span>';
                else if (o.status === 'failed') statusBadge = '<span class="status-badge badge-offline">FALLIDA</span>';
                else if (o.status === 'cancelled') statusBadge = '<span class="status-badge badge-offline">CANCELADA</span>';
                else statusBadge = `<span class="status-badge">${o.status}</span>`;

                if (o.workerHostname) {
                    statusBadge += `<div style="font-size: 0.7rem; color: var(--text-muted); font-family: var(--font-mono); margin-top: 3px;">Node: ${o.workerHostname}</div>`;
                }

                // Acciones
                let actionsHtml = '';
                if (o.status === 'pending') {
                    actionsHtml = `
                        <button class="btn btn-icon" title="Ajustar Prioridad" onclick="openPriorityModal('${o.id}', ${p})">⚡</button>
                        <button class="btn btn-icon" title="Pausar Tarea" onclick="pauseTask('${o.id}')">⏸</button>
                        <button class="btn btn-icon btn-danger" title="Cancelar Tarea" onclick="cancelTask('${o.id}')">🛑</button>
                    `;
                } else if (o.status === 'paused') {
                    actionsHtml = `
                        <button class="btn btn-icon" title="Reanudar Tarea" onclick="resumeTask('${o.id}')">▶</button>
                        <button class="btn btn-icon btn-danger" title="Cancelar Tarea" onclick="cancelTask('${o.id}')">🛑</button>
                        <button class="btn btn-icon" title="Eliminar" onclick="deleteTask('${o.id}')">🗑</button>
                    `;
                } else if (o.status === 'processing') {
                    actionsHtml = `
                        <button class="btn btn-icon btn-danger" title="Cancelar Proceso" onclick="cancelTask('${o.id}')">🛑 Interrumpir</button>
                    `;
                } else if (o.status === 'failed' || o.status === 'cancelled') {
                    actionsHtml = `
                        <button class="btn btn-icon" style="color: var(--cyan); border-color: rgba(0,210,255,0.4);" title="Reintentar con 1 clic" onclick="retryTask('${o.id}')">🔄 Reintentar</button>
                        <button class="btn btn-icon" title="Eliminar" onclick="deleteTask('${o.id}')">🗑</button>
                    `;
                } else if (o.status === 'completed' || o.status === 'completed_with_errors') {
                    actionsHtml = `
                        <button class="btn btn-icon" title="Eliminar" onclick="deleteTask('${o.id}')">🗑</button>
                    `;
                }

                html += `
                    <tr>
                        <td>
                            <span class="priority-badge ${pClass}" onclick="openPriorityModal('${o.id}', ${p})" title="Clic para cambiar prioridad">
                                ${p}
                            </span>
                        </td>
                        <td>
                            <span class="type-badge ${typeClass}">${o.type || 'TASK'}</span>
                            <div style="font-size: 0.7rem; color: var(--text-muted); font-family: var(--font-mono); margin-top: 3px;">${o.id.substring(0, 16)}...</div>
                        </td>
                        <td>
                            <span class="project-tag">${o.project}</span>
                        </td>
                        <td>
                            <span class="user-tag">👤 ${o.user || 'Artista'}</span>
                        </td>
                        <td>${detailText}</td>
                        <td>
                            <div class="progress-box">
                                <div class="progress-bar-bg">
                                    <div class="progress-bar-fill ${fillClass}" style="width: ${pct}%"></div>
                                </div>
                                <div class="progress-meta">
                                    <span>${pct}% ${speedText ? '• ' + speedText : ''}</span>
                                    <span>${etaText}</span>
                                </div>
                            </div>
                        </td>
                        <td>
                            ${datesHtml}
                        </td>
                        <td>${statusBadge}</td>
                        <td style="text-align: right;">
                            <div class="action-btns" style="justify-content: flex-end;">
                                ${actionsHtml}
                            </div>
                        </td>
                    </tr>
                `;
            }

            tbody.innerHTML = html;
        }

        let activeRestartHost = null;
        let restartPollingTimer = null;

        function openRestartModalForHost(hostname) {
            const workers = currentSnapshot.workers || [];
            const w = workers.find(item => item.hostname.toLowerCase() === hostname.toLowerCase());
            openRestartModal(hostname, w?.pid || null);
            startRestartPolling(hostname);
        }

        function openRestartModal(hostname, oldPid = null) {
            activeRestartHost = hostname;
            document.getElementById('restartModalTargetHost').innerText = hostname;
            document.getElementById('restartPidInfo').innerText = `PID previo: ${oldPid || 'N/A'}`;
            document.getElementById('restartElapsedLabel').innerText = 'Tiempo transcurrido: 0s';

            // Reset steps
            setStepState(1, 'active', '⏳');
            setStepState(2, 'pending', '○');
            setStepState(3, 'pending', '○');
            setStepState(4, 'pending', '○');

            document.getElementById('restartSuccessBanner').style.display = 'none';
            document.getElementById('restartWarningBanner').style.display = 'none';
            document.getElementById('btnRestartDismiss').style.display = 'inline-block';
            document.getElementById('btnRestartDone').style.display = 'none';

            document.getElementById('restartModal').classList.add('open');
        }

        function closeRestartModal() {
            document.getElementById('restartModal').classList.remove('open');
        }

        function setStepState(stepNum, state, iconChar) {
            const el = document.getElementById(`restartStep${stepNum}`);
            const ic = document.getElementById(`restartIcon${stepNum}`);
            if (!el || !ic) return;

            el.className = 'restart-step ' + (state || '');
            if (state === 'active') {
                ic.innerHTML = '<span class="spin-icon">🔄</span>';
            } else if (state === 'done') {
                ic.innerText = '✅';
            } else {
                ic.innerText = iconChar || '○';
            }
        }

        function startRestartPolling(hostname) {
            if (restartPollingTimer) clearInterval(restartPollingTimer);

            const check = async () => {
                if (!activeRestartHost || activeRestartHost.toLowerCase() !== hostname.toLowerCase()) {
                    clearInterval(restartPollingTimer);
                    return;
                }
                try {
                    const res = await fetch(`/api/server/worker/${encodeURIComponent(hostname)}/restart-status`);
                    const data = await res.json();

                    if (!data.success || !data.active) {
                        return;
                    }

                    document.getElementById('restartElapsedLabel').innerText = `Tiempo transcurrido: ${data.elapsed || 0}s`;
                    if (data.oldPid) {
                        document.getElementById('restartPidInfo').innerText = `PID previo: ${data.oldPid}${data.newPid ? ' ➔ Nuevo: ' + data.newPid : ''}`;
                    }

                    const step = data.step || 1;

                    // Paso 1: Bandera generada
                    setStepState(1, 'done');

                    // Paso 2: Cierre de proceso
                    if (step === 2) {
                        setStepState(2, 'active');
                        setStepState(3, 'pending', '○');
                        setStepState(4, 'pending', '○');
                    } else if (step > 2) {
                        setStepState(2, 'done');
                    } else {
                        setStepState(2, 'pending', '○');
                    }

                    // Paso 3: Relanzamiento supervisor
                    if (step === 3) {
                        setStepState(3, 'active');
                        setStepState(4, 'pending', '○');
                    } else if (step > 3) {
                        setStepState(3, 'done');
                    } else {
                        if (step < 3) setStepState(3, 'pending', '○');
                    }

                    // Paso 4 / Completado
                    if (step === 4 || data.status === 'completed') {
                        setStepState(1, 'done');
                        setStepState(2, 'done');
                        setStepState(3, 'done');
                        setStepState(4, 'done');

                        document.getElementById('restartSuccessBanner').style.display = 'flex';
                        document.getElementById('restartSuccessDetail').innerText = 
                            `El nodo ${hostname} ha vuelto a estar en línea. PID nuevo: ${data.newPid || 'Confirmado'}. Código y dependencias sincronizados.`;
                        document.getElementById('btnRestartDismiss').style.display = 'none';
                        document.getElementById('btnRestartDone').style.display = 'inline-block';

                        clearInterval(restartPollingTimer);
                        showToast(`✅ Nodo '${hostname}' reiniciado y en línea exitosamente`);
                    } else if (data.status === 'timeout') {
                        document.getElementById('restartWarningBanner').style.display = 'flex';
                        document.getElementById('restartWarningDetail').innerText = data.message || 'Tiempo de espera prolongado.';
                        clearInterval(restartPollingTimer);
                    }
                } catch(e) {}
            };

            restartPollingTimer = setInterval(check, 800);
            check();
        }

        async function restartWorker(hostname) {
            if (!confirm(`¿Solicitar reinicio para el nodo '${hostname}'?\n\nEl worker se detendrá de forma segura y el script supervisor de Windows lo relanzará con la versión más reciente en ~15 segundos.`)) return;

            const workers = currentSnapshot.workers || [];
            const w = workers.find(item => item.hostname.toLowerCase() === hostname.toLowerCase());
            const oldPid = w ? w.pid : null;

            openRestartModal(hostname, oldPid);

            try {
                const res = await fetch(`/api/server/worker/${encodeURIComponent(hostname)}/restart`, { method: 'POST' });
                const data = await res.json();
                if (data.success) {
                    startRestartPolling(hostname);
                } else {
                    showToast('Error: ' + (data.error || 'No se pudo iniciar el reinicio'));
                }
            } catch(e) {
                showToast('Error de comunicación al solicitar reinicio');
            }
        }

        // Control de Levantamiento / Despertar de Workers
        function openWakeModal(hostname, ip) {
            document.getElementById('wakeModalHost').innerText = `${hostname} (${ip || 'N/A'})`;
            document.getElementById('wakeModalContent').innerHTML = `
                <div style="font-size:0.85rem; color:var(--text-dim); text-align:center; padding:20px 0;">
                    <span class="spin-icon">🔄</span> Comprobando conectividad de red con el nodo ${hostname}...
                </div>
            `;
            document.getElementById('wakeModal').classList.add('open');
        }

        function closeWakeModal() {
            document.getElementById('wakeModal').classList.remove('open');
        }

        function updateWakeModal(data, hostname, ip) {
            const container = document.getElementById('wakeModalContent');
            if (data.reachable === false) {
                container.innerHTML = `
                    <div class="restart-warning-banner" style="display:flex; flex-direction:column; gap:8px;">
                        <div style="display:flex; align-items:center; gap:10px;">
                            <div class="warning-icon">⚠️</div>
                            <div class="warning-headline">Equipo o Máquina Virtual APAGADA</div>
                        </div>
                        <div class="warning-detail" style="line-height:1.5;">
                            El nodo <b>${hostname}</b> (${ip || 'IP desconocida'}) no responde a las solicitudes de red.<br><br>
                            <b>¿Cómo encenderlo?</b><br>
                            1. Si es una <b>máquina virtual</b> (ej. VM 105), enciéndala en el hipervisor (VMware / Proxmox).<br>
                            2. Si es una <b>estación física</b>, encienda el equipo manualmente.<br>
                            3. Al iniciar sesión en Windows, si ejecutó <i>Crear_Inicio_Automatico_Worker.bat</i>, el worker arrancará automáticamente.
                        </div>
                    </div>
                `;
            } else if (data.success) {
                container.innerHTML = `
                    <div class="restart-success-banner" style="display:flex; flex-direction:column; gap:8px;">
                        <div style="display:flex; align-items:center; gap:10px;">
                            <div class="success-icon">✅</div>
                            <div class="success-headline">¡Orden de Inicio Ejecutada!</div>
                        </div>
                        <div class="success-detail" style="line-height:1.5;">
                            ${data.message || 'Se envió la orden de ejecución al nodo.'}<br>
                            En unos segundos el worker comenzará a emitir latidos y se pondrá en verde en el panel.
                        </div>
                    </div>
                `;
                showToast(`✅ ${data.message}`);
            } else {
                container.innerHTML = `
                    <div class="restart-warning-banner" style="display:flex; flex-direction:column; gap:8px;">
                        <div style="display:flex; align-items:center; gap:10px;">
                            <div class="warning-icon">ℹ️</div>
                            <div class="warning-headline">Equipo Encendido - Inicio Manual Requerido</div>
                        </div>
                        <div class="warning-detail" style="line-height:1.5;">
                            ${data.message || 'Windows rechazó el inicio remoto por falta de permisos RPC.'}<br><br>
                            <b>Para que inicie siempre solo:</b> Ejecute <code>Crear_Inicio_Automatico_Worker.bat</code> en ese equipo para registrar la tarea de inicio automático de Windows.
                        </div>
                    </div>
                `;
            }
        }

        async function wakeWorker(hostname) {
            const workers = currentSnapshot.workers || [];
            const w = workers.find(item => item.hostname.toLowerCase() === hostname.toLowerCase());
            const ip = w?.ip || '';

            openWakeModal(hostname, ip);

            try {
                const res = await fetch(`/api/server/worker/${encodeURIComponent(hostname)}/wake`, { method: 'POST' });
                const data = await res.json();
                updateWakeModal(data, hostname, ip);
            } catch(e) {
                updateWakeModal({ success: false, reachable: false, message: 'Error de comunicación al consultar el nodo.' }, hostname, ip);
            }
        }

        async function startLocalWorker() {
            showToast('⚡ Iniciando Worker en este servidor...');
            try {
                const res = await fetch('/api/server/worker/start-local', { method: 'POST' });
                const data = await res.json();
                if (data.success) {
                    showToast(`✅ ${data.message}`);
                } else {
                    showToast(`ℹ️ ${data.message || 'El worker ya está activo'}`);
                }
            } catch(e) {
                showToast('Error al iniciar worker local');
            }
        }

        // Acciones API
        async function toggleGlobalQueue() {
            try {
                const res = await fetch('/api/server/queue/pause', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({}) });
                const data = await res.json();
                showToast(data.queuePaused ? '⏸ Cola global pausada en todos los workers' : '▶ Cola global reanudada');
            } catch(e) {
                showToast('Error al modificar estado de cola');
            }
        }

        async function pauseTask(id) {
            try {
                await fetch(`/api/server/task/${id}/pause`, { method: 'POST' });
                showToast(`Tarea ${id} pausada`);
            } catch(e) {
                showToast('Error al pausar tarea');
            }
        }

        async function resumeTask(id) {
            try {
                await fetch(`/api/server/task/${id}/resume`, { method: 'POST' });
                showToast(`Tarea ${id} reanudada`);
            } catch(e) {
                showToast('Error al reanudar tarea');
            }
        }

        async function cancelTask(id) {
            if (!confirm(`¿Cancelar tarea ${id}? Si está en ejecución, se abortará el subproceso Rclone.`)) return;
            try {
                await fetch(`/api/server/task/${id}/cancel`, { method: 'POST' });
                showToast(`Tarea ${id} cancelada`);
            } catch(e) {
                showToast('Error al cancelar tarea');
            }
        }

        async function retryTask(id) {
            try {
                await fetch(`/api/server/task/${id}/retry`, { method: 'POST' });
                showToast(`Tarea ${id} puesta en reintento`);
            } catch(e) {
                showToast('Error al reintentar tarea');
            }
        }

        async function deleteTask(id) {
            if (!confirm(`¿Eliminar orden ${id} permanentemente?`)) return;
            try {
                await fetch(`/api/server/task/${id}/delete`, { method: 'POST' });
                showToast(`Tarea ${id} eliminada`);
            } catch(e) {
                showToast('Error al eliminar tarea');
            }
        }

        async function clearFinishedHistory() {
            if (!confirm('¿Eliminar del historial todas las tareas completadas y fallidas?')) return;
            try {
                const res = await fetch('/api/server/queue/clear-history', { method: 'POST' });
                const data = await res.json();
                showToast(`Historial limpiado (${data.clearedCount || 0} órdenes eliminadas)`);
            } catch(e) {
                showToast('Error al limpiar historial');
            }
        }

        // Modal de Prioridad
        function openPriorityModal(id, priority) {
            targetTaskIdForPriority = id;
            document.getElementById('modalTaskDesc').innerText = `Orden ID: ${id}`;
            updateModalSlider(priority);
            document.getElementById('priorityModal').classList.add('open');
        }

        function closePriorityModal() {
            document.getElementById('priorityModal').classList.remove('open');
            targetTaskIdForPriority = null;
        }

        function updateModalSlider(val) {
            const v = parseInt(val, 10);
            document.getElementById('modalPrioritySlider').value = v;
            document.getElementById('modalSliderVal').innerText = v;
            const valEl = document.getElementById('modalSliderVal');
            if (v >= 90) valEl.style.color = 'var(--rose)';
            else if (v >= 75) valEl.style.color = 'var(--accent)';
            else if (v <= 30) valEl.style.color = 'var(--text-dim)';
            else valEl.style.color = 'var(--cyan)';
        }

        async function saveTaskPriority() {
            if (!targetTaskIdForPriority) return;
            const priority = parseInt(document.getElementById('modalPrioritySlider').value, 10);
            try {
                await fetch(`/api/server/task/${targetTaskIdForPriority}/priority`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ priority })
                });
                showToast(`Prioridad actualizada a ${priority}`);
                closePriorityModal();
            } catch(e) {
                showToast('Error al guardar prioridad');
            }
        }

        // Iniciar
        initSSE();
    </script>
</body>
</html>
