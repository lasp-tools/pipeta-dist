{
    "project_name": "MANGO_ICK",
    "version": "1.0.0",
    "paths": {
        "root_work": "Z:/mango/ick/",
        "root_media": "M:/Mi unidad/Z/INTERNO/MEDIA/mango/ick/",
        "templates": "m:/Mi unidad/Z/INTERNO/TOOLS/AntiGravity/Scripts/Pipeta/templates/"
    },
    "naming_convention": {
        "style": "snake_case",
        "separator": "_",
        "shot_format": "s{SEQ}_sh{SHOT}",
        "version_padding": 4,
        "forbidden_chars": [
            " ",
            "ñ",
            "á",
            "é",
            "í",
            "ó",
            "ú"
        ]
    },
    "entities": {
        "asset": {
            "root": "assets",
            "categories": [
                "chars",
                "props",
                "envs",
                "vehicles"
            ],
            "default_structure": [
                {
                    "name": "work",
                    "children": [
                        "blend",
                        "substance",
                        "zbrush"
                    ]
                },
                {
                    "name": "publish",
                    "children": [
                        "geo",
                        "tex",
                        "lookdev"
                    ]
                },
                {
                    "name": "_in",
                    "children": [
                        "ref",
                        "concept"
                    ]
                }
            ]
        },
        "shot": {
            "root": "episodios",
            "structure_mirror_media": true,
            "default_structure": [
                {
                    "name": "3d",
                    "children": [
                        "anim",
                        "layout",
                        "lighting",
                        "fx"
                    ]
                },
                {
                    "name": "2d",
                    "children": [
                        "comp",
                        "ae",
                        "render_layers"
                    ]
                },
                {
                    "name": "_out",
                    "children": [
                        "dailies",
                        "preview"
                    ]
                }
            ]
        }
    }
}